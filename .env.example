# Локальный просмотр: npm run build && npm start
APP_MODE=local
HOST=127.0.0.1
PORT=4048

# Railway: задать в Variables, а не коммитить .env
# NODE_ENV=production
# APP_MODE=telegram
# HOST=0.0.0.0
# BOT_TOKEN=<токен из BotFather>
# BOT_USERNAME=HeroicHeroesBot
# MINI_APP_URL=https://<домен>.up.railway.app
# ALLOWED_TELEGRAM_IDS=<твой числовой ID>,<ID друга>
# Если список пуст, вход закрыт всем; /id у бота продолжает работать.
# RUN_BOT=true
# DATA_DIR=/data
# TZ=Europe/Moscow
# PORT предоставляет Railway; том нужно подключить отдельно в /data.
